# OpenRouter API key yahan dalein. Free key banane ke liye: https://openrouter.ai/keys
# Is file ko copy kar ke ".env.local" naam se save karein aur asli key dalein.
OPENROUTER_API_KEY=your_key_here

# Optional: model override. Defaults to poolside/laguna-m.1:free.
OPENROUTER_MODEL=poolside/laguna-m.1:free
